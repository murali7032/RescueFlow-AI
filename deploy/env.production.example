# Copy values into Cloud Run env / Secret Manager — do not commit secrets.

ENVIRONMENT=production
DEMO_MODE=false
AUTO_CREATE_TABLES=false
DOCS_ENABLED=false
LOG_LEVEL=INFO

# Secret Manager: foodbridge-database-url → DATABASE_URL
# postgresql+psycopg2://foodbridge:PASSWORD@/foodbridge?host=/cloudsql/PROJECT:asia-south1:foodbridge-pg
DATABASE_URL=REPLACE_VIA_SECRET_MANAGER

# Exact Firebase Hosting origins (comma-separated, https only, no *)
CORS_ORIGINS=https://foodbridge-donor.web.app,https://foodbridge-recipient.web.app,https://foodbridge-admin.web.app

FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
GOOGLE_CLOUD_PROJECT=YOUR_GCP_PROJECT_ID
GOOGLE_CLOUD_LOCATION=asia-south1
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-2.0-flash
AI_ENABLED=true
