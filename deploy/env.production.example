# Copy values into Cloud Run env / Secret Manager — do not commit secrets.

ENVIRONMENT=production
# Cup / public demo: demo role headers (X-Demo-Role). Lock CORS to UI Cloud Run URLs.
DEMO_MODE=true
AUTO_CREATE_TABLES=false
DOCS_ENABLED=false
LOG_LEVEL=INFO

# Secret Manager: foodbridge-database-url → DATABASE_URL
# postgresql+psycopg2://foodbridge:PASSWORD@/foodbridge?host=/cloudsql/PROJECT:asia-south1:foodbridge-pg
DATABASE_URL=REPLACE_VIA_SECRET_MANAGER

# Exact Cloud Run UI origins (comma-separated). Use * only for first boot before UIs exist.
CORS_ORIGINS=https://foodbridge-donor-ui-XXXX.a.run.app,https://foodbridge-recipient-ui-XXXX.a.run.app,https://foodbridge-admin-ui-XXXX.a.run.app

GOOGLE_CLOUD_PROJECT=YOUR_GCP_PROJECT_ID
GOOGLE_CLOUD_LOCATION=asia-south1
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-2.0-flash
AI_ENABLED=true
