# =============================================================================
# LOCAL DEVELOPMENT (defaults)
# =============================================================================
ENVIRONMENT=development
DEMO_MODE=true
AUTO_CREATE_TABLES=true
LOG_LEVEL=INFO
DOCS_ENABLED=true

DATABASE_URL=sqlite:///./foodbridge.db

# Local Vite apps only — Cloud Shell uses Vite proxy (same-origin), no CORS needed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Vertex
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=asia-south1
# GOOGLE_GENAI_USE_VERTEXAI=true
# GEMINI_MODEL=gemini-2.0-flash
# AI_ENABLED=true

# =============================================================================
# PRODUCTION (Cloud Run) — set via gcloud --set-env-vars / --set-secrets
# Never commit real values. See deploy/env.production.example
# =============================================================================
# ENVIRONMENT=production
# DEMO_MODE=true
# AUTO_CREATE_TABLES=false
# DOCS_ENABLED=false
# DATABASE_URL=postgresql+psycopg2://USER:PASS@/foodbridge?host=/cloudsql/PROJECT:REGION:INSTANCE
# CORS_ORIGINS=https://foodbridge-ui-XXXX.a.run.app
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=asia-south1
# GOOGLE_GENAI_USE_VERTEXAI=true
# AI_ENABLED=true
