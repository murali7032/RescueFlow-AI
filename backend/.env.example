# Copy to .env and adjust. Never commit real secrets.

ENVIRONMENT=development
DEMO_MODE=true
AUTO_CREATE_TABLES=true
LOG_LEVEL=INFO

# Local SQLite (default) or Cloud SQL Postgres:
# DATABASE_URL=sqlite:///./foodbridge.db
# DATABASE_URL=postgresql+psycopg2://foodbridge:PASSWORD@/foodbridge?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=sqlite:///./foodbridge.db

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Firebase (optional — leave unset to use demo headers locally)
# FIREBASE_PROJECT_ID=your-firebase-project
# FIREBASE_CREDENTIALS_JSON=

# Vertex AI / Gemini (optional — explanations fall back without these)
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=asia-south1
# GOOGLE_GENAI_USE_VERTEXAI=true
# GEMINI_MODEL=gemini-2.0-flash
# AI_ENABLED=true

# Matching weights (optional overrides)
# WEIGHT_DEADLINE=0.35
# WEIGHT_CAPACITY=0.30
# WEIGHT_DISTANCE=0.20
# WEIGHT_PREFERENCE=0.15
