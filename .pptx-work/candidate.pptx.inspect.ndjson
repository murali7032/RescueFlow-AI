{"kind":"textbox","id":"sh/ved0jihs","slideIndex":1,"position":{"left":130,"top":215,"width":700,"height":185},"name":"Submission content","text":"Surplus food is time-sensitive. A decline, capacity mismatch, or unanswered invitation can leave safe food unclaimed while the pickup deadline approaches.\n\nRescueFlow continues matching after the first offer and routes remaining portions to the next feasible recipient.","geometry":"rect","lineWidth":0,"style":{"fontSize":24,"typeface":"Google Sans Flex","color":"#FFFFFF","alignment":"center"}}
